# Optional trusted backend only. Never copy credentials into docs/ or Pages.
# Public market REST polling works without a Kalshi key if network access permits.
KALSHI_REST_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Long random operator token protects all private portfolio and mutation endpoints.
# Provision through your host's secret store; do not enter it in chat or commit it.
KALSHI_OPERATOR_TOKEN=
KALSHI_ENABLE_DEMO_ORDERS=false
KALSHI_PAPER_AUTOMATION=true
KALSHI_POLL_SECONDS=30
KALSHI_MAX_PAGES=100
KALSHI_MAX_ORDER_DOLLARS=10
KALSHI_MAX_SESSION_DOLLARS=100
KALSHI_ALLOWED_ORIGINS=https://kanlerxz87-cyber.github.io
# Path is relative to the working directory. Runtime data is private and ignored.
KALSHI_DB_PATH=services/kalshi/data/observations.sqlite3
KALSHI_STATIC_DIR=docs
