# Python build/test artifacts and virtualenvs.
# NOTE: a merge on 2026-11-22 dropped these rules, and 3884 .venv files plus 1762 .pyc binaries
# were committed to main as a result. They are restored here and the artifacts were untracked.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Local state / secrets
.env
*.pem
*.key
!docs/**/*.key
secrets/
state/
*.db
*.db-journal
app_data/*.tmp

# OS / editor
.DS_Store
.idea/
.vscode/
*.log

# Build scratch
public/
_site/
coverage/

# Build output kept in git on purpose: docs/ is the published GitHub Pages site.
